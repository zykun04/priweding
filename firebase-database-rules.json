{
  "rules": {
    "wishes": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['name', 'message', 'attendance', 'createdAt']) && newData.numChildren() === 4",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "message": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "attendance": { ".validate": "newData.isString() && (newData.val() === 'Insyaallah hadir' || newData.val() === 'Mohon maaf, belum bisa hadir')" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 300000" }
      }
    }
  }
}